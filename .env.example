# ---------------------------------------------------------------- core (required)
# Generate both with:  seo-engine gen-secrets
SEO_SECRET_KEY=
SEO_API_KEYS=
SEO_ENVIRONMENT=development          # production = JSON logs, API keys mandatory, Alembic migrations

# Local development defaults (docker-compose overrides these with Postgres + Redis)
SEO_DATABASE_URL=sqlite+aiosqlite:///./seo_engine.db
SEO_REDIS_URL=                       # empty = jobs + scheduler run inside the API process

# ---------------------------------------------------------------- LLM (any provider; also editable in the UI)
# Format "<provider>:<model>" — anthropic, openai, google-gla, groq, mistral, deepseek, xai, openrouter,
# ollama, bedrock, azure, openai-compatible, ...
SEO_LLM_MODEL=anthropic:claude-opus-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# SEO_LLM_BASE_URL=                  # for ollama / openai-compatible endpoints

# ---------------------------------------------------------------- Compliance Judge (TypeSafe Jev)
SEO_JUDGE_MODEL=typesafe:jev-latest
TYPESAFE_API_KEY=

# ---------------------------------------------------------------- memory + context engine
# Mem0 long-term memory + Qdrant knowledge index, embeddings computed locally with FastEmbed (no API key).
SEO_DATA_DIR=./data
SEO_QDRANT_URL=                      # empty = embedded Qdrant on disk (single process); docker-compose sets it
SEO_EMBEDDER=fastembed               # fastembed | hash (offline, no model download)
SEO_EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------- AI workforce
SEO_TASK_CONCURRENCY=3               # tasks worked in parallel per process
SEO_TASK_REQUEST_LIMIT=25            # max LLM requests per task
SEO_MAX_TASKS_PER_CYCLE=25
SEO_MAX_TASK_DEPTH=3                 # how deep delegation chains may go

# ---------------------------------------------------------------- optional
SEO_PAGESPEED_API_KEY=               # Google PageSpeed Insights API key (Core Web Vitals)
SEO_MAX_PAGES=300
SEO_IMPACT_WINDOW_DAYS=14            # measure ranking impact of fixes after N days; auto-rollback if worse
SEO_AGENT_REQUEST_LIMIT=60           # max LLM requests per optimisation cycle
POSTGRES_PASSWORD=change-me
PORT=8000

# ---- LLM spend control
SEO_LLM_DAILY_TOKEN_BUDGET=0         # tokens/day across all employees + chat; 0 = unlimited (also editable in the UI)

# ---- Research integrations (optional; also editable in Workspace settings → Integrations)
SEO_SERP_PROVIDER=                   # serper | serpapi | brave — live results for rank checks & competitor research
SEO_SERP_API_KEY=
SEO_SERP_COUNTRY=us
SEO_SERP_LANGUAGE=en
SEO_OPENPAGERANK_API_KEY=            # domain authority (free at openpagerank.com)
SEO_INDEXNOW_KEY=                    # instant indexing on Bing/Yandex/Seznam

# ---- Code edits (Web Engineer) — needs a GitHub or local connector
SEO_AIDER_PATH=                      # default: `aider` on PATH or ./.tools/aider/bin/aider
SEO_AIDER_TIMEOUT_SECONDS=900
SEO_WORKSPACE_MAX_MB=400
SEO_CODE_EXECUTION_ENABLED=false     # let the engineer run the site's build/lint/test scripts (run in a container!)

# ---- Notifications (also editable in the UI)
SEO_PUBLIC_URL=                      # e.g. https://rankcrew.example.com — for links in messages
SEO_SLACK_WEBHOOK_URL=
SEO_NOTIFY_WEBHOOK_URL=
SEO_SMTP_HOST=
SEO_SMTP_PORT=587
SEO_SMTP_USER=
SEO_SMTP_PASSWORD=
SEO_SMTP_FROM=
SEO_NOTIFY_EMAIL=
